{
  "name": "provider-status-mcp",
  "version": "0.2.5",
  "description": "MCP server and CLI that aggregates Claude, Codex, and Copilot status into a single view.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js"
  },
  "bin": {
    "provider-status-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts --mcp",
    "prepack": "npm run build",
    "start": "node dist/cli.js --mcp",
    "status": "tsx src/cli.ts",
    "status:pretty": "tsx src/cli.ts --pretty",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "codex",
    "copilot",
    "mcp",
    "quota",
    "rate-limit",
    "usage",
    "status"
  ],
  "author": "Dmytro Vakulenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrSmile444/provider-status-mcp.git"
  },
  "homepage": "https://github.com/DrSmile444/provider-status-mcp#readme",
  "bugs": {
    "url": "https://github.com/DrSmile444/provider-status-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "claude-status-mcp": "file:../claude-usage-mcp",
    "codex-status-mcp": "file:../codex-status-mcp",
    "copilot-status-mcp": "file:../copilot-status-mcp"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}

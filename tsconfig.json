      "codex-status-mcp": ["./node_modules/codex-status-mcp/dist/index.d.ts"],
      "copilot-status-mcp": ["./node_modules/copilot-status-mcp/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
